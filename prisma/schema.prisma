// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Propietario {
  id       String     @id @default(uuid()) @db.Uuid
  nombre   String
  email    String     @unique
  mascotas Paciente[]
}

model Paciente {
  id            String      @id @default(uuid()) @db.Uuid
  nombre        String
  fechaAlta     DateTime    @db.Date
  sintomas      String
  propietarioId String      @db.Uuid
  propietario   Propietario @relation(fields: [propietarioId], references: [id])
  @@index([propietarioId])
}

model Juego {
  id             String  @id @default(uuid()) @db.Uuid
  slug           String  @unique
  titulo         String
  subtitulo      String
  plataforma     String
  nombre         String
  descripcion    String
  precio         Int
  precioAnterior Int?
  etiqueta       String?
  rating         Float
  resenas        Int
  preventa       Boolean @default(false)
  arte           String
  carrito        CarritoItem[]
  imagenVersion  Int     @default(0)
  imagen         JuegoImagen?

  @@index([plataforma])
}

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  usuario      String        @unique
  passwordHash String
  rol          String        @default("CLIENTE")
  carrito      CarritoItem[]
  pedidos      Pedido[]
}

model CarritoItem {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @db.Uuid
  juegoId   String  @db.Uuid
  cantidad  Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  juego     Juego   @relation(fields: [juegoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, juegoId])
}

model Pedido {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  total     Int
  creado    DateTime @default(now())
  items     Json
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

// Los bytes van aparte para que listar juegos no cargue las imágenes.
model JuegoImagen {
  juegoId String @id @db.Uuid
  tipo    String
  datos   Bytes
  juego   Juego  @relation(fields: [juegoId], references: [id], onDelete: Cascade)
}
